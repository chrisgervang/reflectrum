[Unit]
Description=Reflectrum static web application
After=local-fs.target

[Service]
Type=simple
User=pi
Group=pi
ExecStart=/usr/bin/python3 -m http.server 3000 --bind 127.0.0.1 --directory /opt/reflectrum
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
